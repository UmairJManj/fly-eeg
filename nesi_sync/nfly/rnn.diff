+import os
+_USE_CSR = os.environ.get("NFLY_CSR", "0") == "1"
+
+
+def _csr_index(model):
+    """Sorted CSR structure of the fixed edge list (rows = post for W, rows = pre for W^T); cached per edge list."""
+    key = (model.pre.data_ptr(), model.post.data_ptr(), model.pre.numel())
+    c = getattr(model, "_csr_idx", None)
+    if c is None or c[0] != key:
+        n, dev, S = model.n, model.pre.device, {}
+        for tag, r, col in (("f", model.post, model.pre), ("b", model.pre, model.post)):
+            perm = torch.argsort(r.long() * n + col.long())
+            S["perm_" + tag] = perm; S["col_" + tag] = col[perm].int()
+            S["crow_" + tag] = torch.cat([torch.zeros(1, device=dev, dtype=torch.long),
+                                          torch.bincount(r, minlength=n).cumsum(0)]).int()
+        c = (key, S); model._csr_idx = c
+    return c[1]
+
+
+class _CSRRecurrent(torch.autograd.Function):
+    """y = W h via CSR SpMM. Gradient w.r.t. the (row-sorted) edge values via SDDMM; only h is saved."""
+
+    @staticmethod
+    def forward(ctx, h, wf, wb, S, n):
+        ctx.save_for_backward(h, wb); ctx.S, ctx.n = S, n
+        W = torch.sparse_csr_tensor(S["crow_f"], S["col_f"], wf.detach(), (n, n))
+        return torch.sparse.mm(W, h.t()).t()
+
+    @staticmethod
+    def backward(ctx, g):
+        h, wb = ctx.saved_tensors; S, n = ctx.S, ctx.n; gh = gwf = None
+        g = g.contiguous()
+        if ctx.needs_input_grad[0]:
+            Wt = torch.sparse_csr_tensor(S["crow_b"], S["col_b"], wb, (n, n))
+            gh = torch.sparse.mm(Wt, g.t()).t()
+        if ctx.needs_input_grad[1]:
+            pat = torch.sparse_csr_tensor(S["crow_f"], S["col_f"], torch.zeros_like(wb), (n, n))
+            gwf = torch.sparse.sampled_addmm(pat, g.t().contiguous(), h.contiguous(), beta=0.0).values()
+        return gh, gwf, None, None, None
+
+
+def _csr_product(model, h, w):
+    S = _csr_index(model)
+    c = getattr(model, "_csr_w", None)
+    if c is None or c[0] is not w:                      # permute the edge values once per unroll, not per step
+        c = (w, w[S["perm_f"]], w.detach()[S["perm_b"]]); model._csr_w = c
+    return _CSRRecurrent.apply(h, c[1], c[2], S, model.n)
+
+
